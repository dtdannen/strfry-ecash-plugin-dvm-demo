# NIP-17 Encrypted DVM Configuration Example
# Copy this file to .env and update with your values

# DVM Keys (auto-generated on first run if not provided)
# DVM_SECRET_KEY=nsec1...
# DVM_NPUB=npub1...
# DVM_PUBKEY_HEX=...

# Relay Configuration (defaults to local strfry relay)
# RELAY_URL=ws://strfry:7777

# This DVM only accepts encrypted requests using NIP-17 gift wrap
# Clients must encrypt their requests for this specific DVM pubkey